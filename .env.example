# Copia este archivo como .env.local y rellena los valores. NUNCA subas .env.local a GitHub.

# TMDB: "API Read Access Token" (el largo) de tu cuenta de TMDB
TMDB_READ_TOKEN=

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección de la web (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificaciones push (claves VAPID: se generan con  npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Clave que comparte la base de datos con la web para pedir el envío de pushes (también en Supabase Vault)
PUSH_WEBHOOK_SECRET=
# Clave de la tarea diaria de Vercel (avisos de capítulos nuevos)
CRON_SECRET=
# Supabase -> Project Settings -> API Keys -> service_role (solo servidor, NUNCA en el navegador ni en GitHub)
SUPABASE_SERVICE_ROLE_KEY=
